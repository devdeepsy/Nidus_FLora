<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        app:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="?attr/colorPrimary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="bottom|start"
                android:paddingBottom="10dp">

                <!-- Left: new chat + history -->
                <ImageButton
                    android:id="@+id/newChatButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_add"
                    android:contentDescription="New chat"
                    app:tint="?attr/colorOnPrimary"/>

                <ImageButton
                    android:id="@+id/chatsButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_history"
                    android:contentDescription="Chat history"
                    app:tint="?attr/colorOnPrimary"/>

                <!-- Centre: title pushed by spacer -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingBottom="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AgriExpert"
                        android:textSize="11sp"
                        android:letterSpacing="0.12"
                        android:textAllCaps="true"
                        android:alpha="0.75"
                        android:textColor="?attr/colorOnPrimary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AgriBot"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimary"/>

                </LinearLayout>

                <!-- Right: language button -->
                <ImageButton
                    android:id="@+id/languageButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_lang"
                    android:contentDescription="Change language"
                    app:tint="?attr/colorOnPrimary"/>

            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>
    <!-- Top buttons row -->


    <!-- Chat messages - takes remaining space -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/colorSurface"/>
    <LinearLayout
        android:id="@+id/messageCounterBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceVariant"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvMessageCounter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:text="8 messages remaining today" />

        <TextView
            android:id="@+id/tvWatchAd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Watch Ad +4"
            android:textSize="12sp"
            android:textColor="?attr/colorPrimary"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="visible" />

    </LinearLayout>

    <!-- Input area at bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- Text input -->
        <EditText
            android:id="@+id/userInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type your message..."
            android:padding="12dp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:maxLines="3"
            android:inputType="textMultiLine"
            android:imeOptions="actionSend" />

        <!-- Send button -->
        <Button
            android:id="@+id/sendButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:text="Send"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="?attr/colorOnPrimary"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- TTS button -->
        <ImageButton
            android:id="@+id/ttsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_volume"
            android:contentDescription="Text to speech"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:scaleType="center"/>

        <!--STS button -->
        <ImageButton
            android:id="@+id/stsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_mic"
            android:contentDescription="Speech to Text"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:scaleType="center"/>

    </LinearLayout>


</LinearLayout>