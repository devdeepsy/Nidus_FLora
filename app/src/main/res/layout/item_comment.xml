<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp"
    android:gravity="top">

    <!-- Avatar -->
    <ImageView
        android:id="@+id/IvCommentAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="10dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_person_placholder"
        android:contentDescription="Commenter avatar"/>

    <!-- Content column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Author + timestamp row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/TvCommentAuthor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Author"/>

            <TextView
                android:id="@+id/TvCommentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:text="2 min ago"/>

        </LinearLayout>

        <!-- Comment text -->
        <TextView
            android:id="@+id/TvCommentText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.3"
            android:textColor="?attr/colorOnSurface"
            android:text="Comment text goes here"/>

    </LinearLayout>

    <!-- Delete button — owner only, gone by default -->
    <ImageButton
        android:id="@+id/BtnDeleteComment"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete comment"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_cross"
        android:visibility="gone"
        app:tint="?attr/colorError"/>

</LinearLayout>